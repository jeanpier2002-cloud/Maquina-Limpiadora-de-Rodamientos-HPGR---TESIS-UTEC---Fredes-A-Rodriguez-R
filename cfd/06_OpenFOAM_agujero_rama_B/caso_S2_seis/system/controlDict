FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     kinematicParcelFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.035;

deltaT          5e-05;

writeControl    runTime;

writeInterval   0.0175;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

adjustTimeStep  no;

maxCo           0.5;


