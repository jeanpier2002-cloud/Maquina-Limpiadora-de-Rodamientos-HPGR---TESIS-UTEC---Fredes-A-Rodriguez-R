FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    "alpha.water.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 1;
        cAlpha          1;
        MULESCorr       yes;
        nLimiterIter    5;
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
    "pcorr.*"
    {
        solver          PCG;
        preconditioner  { preconditioner GAMG; tolerance 1e-5; relTol 0; smoother GaussSeidel; }
        tolerance       1e-5;
        relTol          0;
        maxIter         50;
    }
    p_rgh
    {
        // banco e1_banco_presion.sh (N40, 4 rangos): GAMG+GaussSeidel relTol 0.01 = 2,68 s/paso (104 it);
        // GAMG+DIC relTol 0.05 = 0,93 s/paso (16 it). Misma tolerancia absoluta 1e-7.
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-7;
        relTol          0.05;
    }
    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }
    "(U|k|omega).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0;
    }
}
PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    1;
    nCorrectors         3;
    nNonOrthogonalCorrectors 0;
}
relaxationFactors { equations { ".*" 1; } }
